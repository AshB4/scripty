# Local server and official mcp-clickhouse configuration only.
# Copy to .env and replace placeholders. Never use VITE_ prefixes for these values.

# ClickHouse Cloud connection used by the local official MCP server.
CLICKHOUSE_HOST='your-clickhouse-host'
CLICKHOUSE_PORT='8443'
CLICKHOUSE_USER='your-clickhouse-user'
CLICKHOUSE_PASSWORD='your-clickhouse-password'
CLICKHOUSE_SECURE='true'
CLICKHOUSE_VERIFY='true'
CLICKHOUSE_ALLOW_WRITE_ACCESS='true'
CLICKHOUSE_ALLOW_DROP='false'

# Local MCP transport. Keep this loopback-only and unauthenticated for local development.
CLICKHOUSE_MCP_SERVER_TRANSPORT='http'
CLICKHOUSE_MCP_BIND_HOST='127.0.0.1'
CLICKHOUSE_MCP_BIND_PORT='8000'
CLICKHOUSE_MCP_ALLOWED_HOSTS='127.0.0.1:8000,localhost:8000'
CLICKHOUSE_MCP_AUTH_DISABLED='true'
# Return bounded tool responses as JSON instead of opening short-lived SSE streams.
FASTMCP_JSON_RESPONSE='true'

# Scripty server connection to the local MCP server.
CLICKHOUSE_MCP_URL='http://127.0.0.1:8000/mcp'
# CLICKHOUSE_MCP_AUTH_TOKEN='set-only-when-your-local-mcp-requires-a-bearer-token'

# Vertex AI runtime. Authenticate locally with Application Default Credentials.
GOOGLE_CLOUD_PROJECT='your-google-cloud-project'
GOOGLE_CLOUD_LOCATION='us-central1'
GOOGLE_AGENT_MODEL='gemini-2.5-flash'
GOOGLE_GENAI_USE_VERTEXAI='true'
